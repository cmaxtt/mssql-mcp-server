# Choose exactly one connection method.
DB_CONNECTION_STRING=

# Individual connection settings (leave all blank when using DB_CONNECTION_STRING).
DB_HOST=
DB_PORT=1433
DB_INSTANCE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Timeouts (milliseconds)
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Transient connection retry
DB_MAX_RETRIES=5
DB_RETRY_BASE_DELAY_MS=500
DB_RETRY_MAX_DELAY_MS=10000

# Connection pool
DB_POOL_MIN=0
DB_POOL_MAX=10

# Read-only query tool (off by default)
ENABLE_EXECUTE_QUERY=false
ALLOWED_SCHEMAS=dbo
ALLOWED_TABLES=
QUERY_MAX_ROWS=100
QUERY_MAX_TEXT_BYTES=32768
QUERY_MAX_RESULT_BYTES=1048576
QUERY_MAX_CONCURRENCY=2

# Transport
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Exact comma-separated origins, for example https://app.example.com
MCP_HTTP_ALLOWED_ORIGINS=
# Required for non-loopback binds; use at least 32 random characters.
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_BODY_LIMIT_BYTES=1048576

# All logs go to stderr; stdout remains reserved for MCP stdio.
LOG_LEVEL=info
LOG_PRETTY=false
