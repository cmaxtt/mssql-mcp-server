{
    "mcpServers": {
        "mssql-schema": {
            "command": "node",
            "args": [
                "c:/mssql_mcp_server/dist/index.js"
            ],
            "env": {
                "DB_HOST": "your-server",
                "DB_USER": "your-user",
                "DB_PASSWORD": "your-password",
                "DB_NAME": "your-database",
                "DB_ENCRYPT": "false",
                "DB_TRUST_CERT": "true"
            }
        }
    }
}
