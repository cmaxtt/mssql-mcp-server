{
  "name": "mssql-mcp-server",
  "version": "1.0.0",
  "description": "A security-focused Model Context Protocol server for Microsoft SQL Server metadata and opt-in read-only queries.",
  "type": "module",
  "bin": {
    "mssql-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    ".env.example",
    "create_least_privilege_login.sql",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "ajv": "8.20.0",
    "fast-uri": "4.1.1",
    "hono": "4.12.32",
    "postcss": "8.5.23"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit/",
    "test:contract": "vitest run tests/contract/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:contract && npm run test:integration",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run typecheck && npm run build && npm run test:unit && npm run test:contract && npm run pack:check",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": ["mcp", "model-context-protocol", "mssql", "sql-server"],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.0.0",
    "mssql": "^12.7.0",
    "node-sql-parser": "^5.4.0",
    "pino": "^10.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
